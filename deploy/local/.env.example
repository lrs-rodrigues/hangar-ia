# Copy to .env. Do not commit the resulting file.
# Generate with a cryptographically random source; this example is deliberately invalid.
HANGAR_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token

# Set after POST /v1/organizations returns the owner key, or preferably after
# creating a workspace-scoped agent key for Codex.
HANGAR_API_KEY=replace-with-a-workspace-scoped-agent-key

# Override only when testing a different prebuilt image.
HANGAR_IMAGE=hangar-ai:local

# Optional semantic profile. Leave hashing-v1 for the zero-download baseline.
# Before selecting local-multilingual-v1, run the documented one-time model
# provisioning command against the persistent Hangar volume.
HANGAR_EMBEDDING_PROFILE=hashing-v1
